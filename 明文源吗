async function migrateAddressList(env, txt = 'ADD.txt') {
    const oldData = await env.KV.get(`/${txt}`);
    const newData = await env.KV.get(txt);

    if (oldData && !newData) {
        await env.KV.put(txt, oldData);
        await env.KV.delete(`/${txt}`);
        return true;
    }
    return false;
}

async function KV(request, env, txt = 'ADD.txt') {
    try {
        if (request.method === "POST") {
            if (!env.KV) return new Response("KV not bound", { status: 400 });
            try {
                const content = await request.text();
                await env.KV.put(txt, content);
                return new Response("ذخیره شد");
            } catch (error) {
                console.error('Error saving KV:', error);
                return new Response("خطا در ذخیره: " + error.message, { status: 500 });
            }
        }

        let content = '';
        let hasKV = !!env.KV;

        if (hasKV) {
            try {
                content = await env.KV.get(txt) || '';
            } catch (error) {
                console.error('Error reading KV:', error);
                content = 'خطا در خواندن داده: ' + error.message;
            }
        }

        return new Response(getKVEditorHTML(content, hasKV), {
            headers: { 'Content-Type': 'text/html; charset=utf-8' }
        });
    } catch (error) {
        return new Response('Error: ' + error.message, { status: 500 });
    }
}

