function getFlagEmoji(countryCode) {
    if (!countryCode) return '';
    const codePoints = countryCode
        .toUpperCase()
        .split('')
        .map(char => 127397 + char.charCodeAt());
    return String.fromCodePoint(...codePoints);
}

const socks5PatternCache = new Map();

async function handleTCPOutBound(remoteSocket, addressRemote, portRemote, rawClientData, webSocket, vlessResponseHeader, log) {
    function useSocks5Pattern(address) {
        if (go2Socks5s.includes('all in') || go2Socks5s.includes('*')) return true;

        return go2Socks5s.some(pattern => {
            if (!socks5PatternCache.has(pattern)) {
                const regexPattern = pattern.replace(/\*/g, '.*');
                socks5PatternCache.set(pattern, new RegExp(`^${regexPattern}$`, 'i'));
            }
            return socks5PatternCache.get(pattern).test(address);
        });
    }

    function tryConnect(hostname, port) {
        try {
            return connect({ hostname, port });
        } catch (error) {
            return null;
        }
    }

    async function tryConnectWithTimeout(hostname, port, timeout = CONNECTION_TIMEOUT) {
        try {
            const socket = connect({ hostname, port });
            const timeoutPromise = new Promise((_, reject) =>
                setTimeout(() => reject(new Error('Connection timeout')), timeout)
            );
            await Promise.race([socket.opened, timeoutPromise]);
            return socket;
        } catch (error) {
            return null;
        }
    }

    const enableSocks5Global = (go2Socks5s.length > 0 && enableSocks) ? useSocks5Pattern(addressRemote) : false;

    async function connectAndWrite(address, port) {
        let tcpSocket = null;
        let connectionError = null;

        if (enableSocks5Global) {
            try {
                tcpSocket = enableHttp ? await httpConnect(address, port) : await socks5Connect(address, port);
                if (tcpSocket) {
                    remoteSocket.value = tcpSocket;
                    const writer = tcpSocket.writable.getWriter();
                    await writer.write(rawClientData);
                    writer.releaseLock();
                    return tcpSocket;
                }
            } catch (err) {
                connectionError = 'SOCKS5 global connection failed: ' + err.message;
                log(connectionError);
            }
        }

        try {
            const directSocket = await tryConnectWithTimeout(address, port);
            if (directSocket) {
                log(`Direct: ${address}:${port}`);
                remoteSocket.value = directSocket;
                const writer = directSocket.writable.getWriter();
                await writer.write(rawClientData);
                writer.releaseLock();
                return directSocket;
            }
        } catch (err) {
            log(`Direct connection failed: ${err.message}`);
        }

        if (enableSocks) {
            try {
                log(`SOCKS5: ${address}:${port}`);
                tcpSocket = enableHttp ? await httpConnect(address, port) : await socks5Connect(address, port);
                if (tcpSocket) {
                    remoteSocket.value = tcpSocket;
                    const writer = tcpSocket.writable.getWriter();
                    await writer.write(rawClientData);
                    writer.releaseLock();
                    return tcpSocket;
                }
            } catch (err) {
                log(`SOCKS5 fallback failed: ${err.message}`);
            }
        }

        if (proxyIP) {
            try {
                log(`ProxyIP: ${proxyIP}`);
                const [proxyAddr, proxyPort] = await parseProxyIP(proxyIP);
                const proxySocket = await tryConnectWithTimeout(proxyAddr, proxyPort || 443);
                if (proxySocket) {
                    remoteSocket.value = proxySocket;
                    const writer = proxySocket.writable.getWriter();
                    await writer.write(rawClientData);
                    writer.releaseLock();
                    return proxySocket;
                }
            } catch (err) {
                log(`ProxyIP fallback failed: ${err.message}`);
            }
        }

        log(`Fallback servers...`);
        const fallbackServers = [
            ['proxyip.fxxk.dedyn.io', 443],
            ['cdn.xn--b6gac.eu.org', 443],
            ['cdn-all.xn--b6gac.eu.org', 443],
        ];

        const results = await Promise.allSettled(
            fallbackServers.map(([host, p]) => tryConnectWithTimeout(host, p, 5000))
        );

        for (const result of results) {
            if (result.status === 'fulfilled' && result.value) {
                tcpSocket = result.value;
                break;
            }
        }

        if (!tcpSocket) {
            throw new Error(connectionError || 'All connection methods failed');
        }

        remoteSocket.value = tcpSocket;
        const writer = tcpSocket.writable.getWriter();
        await writer.write(rawClientData);
        writer.releaseLock();
        return tcpSocket;
    }

    async function retry() {
        log(`Retry with fallback servers...`);

        const fallbackServers = [
            ['proxyip.fxxk.dedyn.io', 443],
            ['cdn.xn--b6gac.eu.org', 443],
            ['cdn-all.xn--b6gac.eu.org', 443],
        ];

        try {
            const tcpSocket = await Promise.any(
                fallbackServers.map(async ([host, port]) => {
                    const socket = await tryConnectWithTimeout(host, port, 5000);
                    if (!socket) throw new Error('Connection failed');
                    return socket;
                })
            );

            log(`Fallback connected`);

            tcpSocket.closed.catch(() => { }).finally(() => {
                safeCloseWebSocket(webSocket);
            });

            remoteSocketToWS(tcpSocket, webSocket, vlessResponseHeader, null, log);
        } catch (error) {
            log(`All fallback servers failed`);
            safeCloseWebSocket(webSocket);
        }
    }

    try {
        const tcpSocket = await connectAndWrite(addressRemote, portRemote);
        remoteSocketToWS(tcpSocket, webSocket, vlessResponseHeader, retry, log);
    } catch (error) {
        log(`خطای اتصال TCP: ${error}`);
        await retry();
    }
}

async function handleUDPOutBound(webSocket, vlessResponseHeader, log) {
    let isVlessHeaderSent = false;
    const transformStream = new TransformStream({
        start(controller) { },
        transform(chunk, controller) {
            for (let index = 0; index < chunk.byteLength;) {
                const lengthBuffer = chunk.slice(index, index + 2);
                const udpPakcetLength = new DataView(lengthBuffer).getUint16(0);
                const udpData = new Uint8Array(chunk.slice(index + 2, index + 2 + udpPakcetLength));
                index = index + 2 + udpPakcetLength;
                controller.enqueue(udpData);
            }
        },
        flush(controller) { }
    });

    const dnsServers = [
        'https://1.1.1.1/dns-query',
        'https://8.8.8.8/dns-query',
        'https://dns.google/dns-query',
    ];

    transformStream.readable.pipeTo(new WritableStream({
        async write(chunk) {
            let dnsQueryResult = null;

            try {
                dnsQueryResult = await Promise.any(
                    dnsServers.map(async (dnsServer) => {
                        const resp = await fetch(dnsServer, {
                            method: 'POST',
                            headers: { 'content-type': 'application/dns-message' },
                            body: chunk
                        });
                        if (!resp.ok) throw new Error('DNS request failed');
                        return resp.arrayBuffer();
                    })
                );
            } catch (e) {
                log('All DNS servers failed');
                return;
            }

            if (!dnsQueryResult) {
                return;
            }

            const udpSize = dnsQueryResult.byteLength;
            const udpSizeBuffer = new Uint8Array([(udpSize >> 8) & 0xff, udpSize & 0xff]);

            if (webSocket.readyState === WS_READY_STATE_OPEN) {
                log(`DNS: ${udpSize}`);
                if (isVlessHeaderSent) {
                    webSocket.send(await new Blob([udpSizeBuffer, dnsQueryResult]).arrayBuffer());
                } else {
                    webSocket.send(await new Blob([vlessResponseHeader, udpSizeBuffer, dnsQueryResult]).arrayBuffer());
                    isVlessHeaderSent = true;
                }
            }
        }
    })).catch((error) => {
        log('DNS Error: ' + error);
    });

    const writer = transformStream.writable.getWriter();
    return { write(chunk) { writer.write(chunk); } };
}

function makeReadableWebSocketStream(webSocketServer, earlyDataHeader, log) {
    let readableStreamCancel = false;
    const stream = new ReadableStream({
        start(controller) {
            webSocketServer.addEventListener("message", (event) => {
                if (readableStreamCancel) return;
                const message = event.data;
                controller.enqueue(message);
            });
            webSocketServer.addEventListener("close", () => {
                safeCloseWebSocket(webSocketServer);
                if (readableStreamCancel) return;
                controller.close();
            });
            webSocketServer.addEventListener("error", (err) => {
                log("WebSocket error");
                controller.error(err);
            });
            const { earlyData, error } = base64ToArrayBuffer(earlyDataHeader);
            if (error) {
                controller.error(error);
            } else if (earlyData) {
                controller.enqueue(earlyData);
            }
        },
        pull(controller) { },
        cancel(reason) {
            if (readableStreamCancel) return;
            log(`ReadableStream cancelled: ${reason}`);
            readableStreamCancel = true;
            safeCloseWebSocket(webSocketServer);
        }
    });
    return stream;
}

async function remoteSocketToWS(remoteSocket, webSocket, vlessResponseHeader, retry, log) {
    let vlessHeaderSent = false;
    let hasIncomingData = false;

    const headerBlob = new Blob([vlessResponseHeader]);

    await remoteSocket.readable.pipeTo(
        new WritableStream({
            start() { },
            async write(chunk, controller) {
                hasIncomingData = true;
                if (webSocket.readyState !== WS_READY_STATE_OPEN) {
                    controller.error("WebSocket is not open");
                    return;
                }
                if (vlessHeaderSent) {
                    webSocket.send(chunk);
                } else {
                    webSocket.send(await new Blob([vlessResponseHeader, chunk]).arrayBuffer());
                    vlessHeaderSent = true;
                }
            },
            close() {
                log(`remoteSocket.readable closed, hasIncomingData: ${hasIncomingData}`);
            },
            abort(reason) {
                console.error("remoteSocket.readable abort", reason);
            }
        })
    ).catch((error) => {
        console.error(`remoteSocketToWS error:`, error.stack || error);
        safeCloseWebSocket(webSocket);
    });

    if (hasIncomingData === false && retry) {
        log(`retry`);
        retry();
    }
}

function base64ToArrayBuffer(base64Str) {
    if (!base64Str) {
        return { earlyData: undefined, error: null };
    }
    try {
        base64Str = base64Str.replace(/-/g, "+").replace(/_/g, "/");
        const decode = atob(base64Str);
        const arryBuffer = Uint8Array.from(decode, (c) => c.charCodeAt(0));
        return { earlyData: arryBuffer.buffer, error: null };
    } catch (error) {
        return { earlyData: undefined, error };
    }
}

let WS_READY_STATE_OPEN = 1;
let WS_READY_STATE_CLOSING = 2;

function safeCloseWebSocket(socket) {
    try {
        if (socket.readyState === WS_READY_STATE_OPEN || socket.readyState === WS_READY_STATE_CLOSING) {
            socket.close();
        }
    } catch (error) {
        console.error("safeCloseWebSocket error", error);
    }
}

async function parseProxyIP(proxyIP) {
    if (!proxyIP) return [null, null];

    let host = proxyIP;
    let port = 443;

    if (proxyIP.includes(':')) {
        const parts = proxyIP.split(':');
        host = parts[0];
        port = parseInt(parts[1]) || 443;
    }

    return [host, port];
}

async function socks5Connect(address, port) {
    const { username, password, hostname, port: socksPort } = socks5AddressParser(socks5Address);
    const socket = connect({ hostname, port: socksPort });

    const writer = socket.writable.getWriter();
    const reader = socket.readable.getReader();

    const greeting = username ?
        new Uint8Array([0x05, 0x02, 0x00, 0x02]) :
        new Uint8Array([0x05, 0x01, 0x00]);
    await writer.write(greeting);

    let res = (await reader.read()).value;
    if (res[0] !== 0x05) {
        throw new Error('SOCKS5 handshake failed');
    }

    if (res[1] === 0x02) {
        const authRequest = new Uint8Array([
            0x01,
            username.length,
            ...new TextEncoder().encode(username),
            password.length,
            ...new TextEncoder().encode(password)
        ]);
        await writer.write(authRequest);
        res = (await reader.read()).value;
        if (res[1] !== 0x00) {
            throw new Error('SOCKS5 authentication failed');
        }
    }

    const addressBytes = new TextEncoder().encode(address);
    const connectRequest = new Uint8Array([
        0x05, 0x01, 0x00, 0x03,
        addressBytes.length,
        ...addressBytes,
        (port >> 8) & 0xff,
        port & 0xff
    ]);
    await writer.write(connectRequest);

    res = (await reader.read()).value;
    if (res[1] !== 0x00) {
        throw new Error(`SOCKS5 connect failed: ${res[1]}`);
    }

    writer.releaseLock();
    reader.releaseLock();

    return socket;
}

function socks5AddressParser(address) {
    let username = '';
    let password = '';
    let hostname = '';
    let port = 1080;

    if (address.includes('@')) {
        const [auth, hostPart] = address.split('@');
        if (auth.includes(':')) {
            [username, password] = auth.split(':');
        } else {
            username = auth;
        }
        address = hostPart;
    }

    if (address.includes(':')) {
        const parts = address.split(':');
        hostname = parts[0];
        port = parseInt(parts[1]) || 1080;
    } else {
        hostname = address;
    }

    return { username, password, hostname, port };
}

async function httpConnect(address, port) {
    const { username, password, hostname, port: httpPort } = socks5AddressParser(socks5Address);
    const socket = connect({ hostname, port: httpPort });

    const writer = socket.writable.getWriter();
    const reader = socket.readable.getReader();

    let connectRequest = `CONNECT ${address}:${port} HTTP/1.1\r\nHost: ${address}:${port}\r\n`;

    if (username) {
        const auth = btoa(`${username}:${password}`);
        connectRequest += `Proxy-Authorization: Basic ${auth}\r\n`;
    }

    connectRequest += '\r\n';

    await writer.write(new TextEncoder().encode(connectRequest));

    const response = await reader.read();
    const responseText = new TextDecoder().decode(response.value);

    if (!responseText.includes('200')) {
        throw new Error(`HTTP proxy failed: ${responseText.split('\r\n')[0]}`);
    }

    writer.releaseLock();
    reader.releaseLock();

    return socket;
}

async function MD5MD5(text) {
    const encoder = new TextEncoder();
    const firstPass = await crypto.subtle.digest('MD5', encoder.encode(text));
    const firstHex = Array.from(new Uint8Array(firstPass)).map(b => b.toString(16).padStart(2, '0')).join('');
    const secondPass = await crypto.subtle.digest('MD5', encoder.encode(firstHex.slice(7, 27)));
    return Array.from(new Uint8Array(secondPass)).map(b => b.toString(16).padStart(2, '0')).join('');
}

