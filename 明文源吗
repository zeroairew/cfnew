async function handleSubscriptionRequest(request, user, url = null) {
  if (!url) url = new URL(request.url);

  const finalLinks = [];
  const workerDomain = url.hostname;
  const target = url.searchParams.get('target') || 'base64';

  // --- 1. ایجاد کانفیگ نمایشی (تایتل) در بالای لیست ---
  // این کانفیگ صرفاً برای نمایش متن زیبا است و کار نمی‌کند (IP: 127.0.0.1)
  const infoRemark = `🔥 | ${toFancyArt('FireGate Service')}`;
  // لینک نمایشی
  const infoLink = `vless://00000000-0000-0000-0000-000000000000@127.0.0.1:443?encryption=none&security=none&type=ws&host=${workerDomain}&path=%2F#${encodeURIComponent(infoRemark)}`;
  finalLinks.push(infoLink);

  // --- 2. تعریف شمارنده سراسری ---
  // این آبجکت به تمام توابع پاس داده می‌شود تا شماره‌ها (01, 02...) پشت سر هم باشند و تکرار نشوند
  let globalIndex = { value: 1 };

  // تابع کمکی داخلی برای افزودن نودها با شمارنده مشترک
  async function addNodesFromList(list) {
    if (ev) {
      finalLinks.push(...generateLinksFromSource(list, user, workerDomain, globalIndex));
    }
    if (et) {
      // اگر تروجان فعال باشد، فرض بر این است که تابع تروجان هم آپدیت شده تا globalIndex بگیرد
      // اگر آپدیت نکردید، ممکن است شماره‌ها در تروجان ریست شوند. 
      // فعلا همان تابع جنریت سورس را صدا میزنیم یا اگر تابع اختصاصی دارد باید آن را هم اصلاح کنید.
      // برای هماهنگی با درخواست شما (VLESS)، اینجا تمرکز روی VLESS است.
      finalLinks.push(...await generateTrojanLinksFromSource(list, user, workerDomain));
    }
    // اگر پروتکل‌های دیگر نیاز بود اینجا اضافه می‌شوند
  }

  // --- 3. اضافه کردن Native Address (کانفیگ‌های اصلی سرور) ---
  if (currentWorkerRegion === 'CUSTOM') {
    const nativeList = [{ ip: workerDomain, isp: 'Native Address', colo: manualWorkerRegion }];
    await addNodesFromList(nativeList);
  } else {
    try {
      const nativeList = [{ ip: workerDomain, isp: 'Native Address', colo: currentWorkerRegion }];
      await addNodesFromList(nativeList);
    } catch (error) {
      if (!currentWorkerRegion) {
        currentWorkerRegion = await detectWorkerRegion(request);
      }

      const bestBackupIP = await getBestBackupIP(currentWorkerRegion);
      if (bestBackupIP) {
        fallbackAddress = bestBackupIP.domain + ':' + bestBackupIP.port;
        const backupList = [{ ip: bestBackupIP.domain, isp: 'ProxyIP-' + currentWorkerRegion, colo: currentWorkerRegion }];
        await addNodesFromList(backupList);
      } else {
        const nativeList = [{ ip: workerDomain, isp: 'Native Address', colo: '' }];
        await addNodesFromList(nativeList);
      }
    }
  }

  // --- 4. اضافه کردن Preferred IPs (سایر کانفیگ‌ها) ---
  const hasCustomPreferred = customPreferredIPs.length > 0 || customPreferredDomains.length > 0;

  if (disablePreferred) {
    // اگر ترجیحی غیرفعال باشد کاری نمی‌کنیم
  } else if (hasCustomPreferred) {
    // اگر IP دستی وارد شده باشد
    if (customPreferredIPs.length > 0 && epi) {
      await addNodesFromList(customPreferredIPs);
    }

    if (customPreferredDomains.length > 0 && epd) {
      const customDomainList = customPreferredDomains.map(d => ({ ip: d.domain, isp: d.name, colo: '' }));
      await addNodesFromList(customDomainList);
    }
  } else {
    // حالت پیش‌فرض (استفاده از لیست‌های آنلاین)
    if (epd) {
      const domainList = directDomains.map(d => ({ ip: d.domain, isp: d.name, colo: '' }));
      await addNodesFromList(domainList);
    }


    if (egi) {
      try {
        const newIPList = await fetchAndParseNewIPs();
        if (newIPList.length > 0) {
          if (ev) {
            // پاس دادن globalIndex به تابع تولید لینک‌های جدید
            finalLinks.push(...generateLinksFromNewIPs(newIPList, user, workerDomain, globalIndex));
          }
          // بخش تروجان اگر نیاز بود...
        }
      } catch (error) {
         // مدیریت خطا
      }
    }
  }

  // --- 5. مدیریت لیست خالی ---
  if (finalLinks.length === 1) { // یعنی فقط نود نمایشی اضافه شده و نود واقعی نداریم
    const errorRemark = toFancyArt("No Nodes Found");
    const errorLink = `vless://00000000-0000-0000-0000-000000000000@127.0.0.1:80?encryption=none&security=none&type=ws&host=error.com&path=%2F#${encodeURIComponent(errorRemark)}`;
    finalLinks.push(errorLink);
  }

  // --- 6. تولید خروجی نهایی ---
  let subscriptionContent;
  let contentType = 'text/plain; charset=utf-8';

  // تشخیص کلاینت برای فرمت خروجی (Clash, Surge, etc)
  // توجه: اگر کلاینت‌ها را می‌خواهید ساپورت کنید باید توابع generateClashConfig و ... را هم
  // چک کنید که با فرمت جدید لینک‌ها سازگار باشند. اما برای Base64 (پیش‌فرض) کد زیر کار می‌کند.
  
  switch (target.toLowerCase()) {
    case atob('Y2xhc2g='): // clash
    case atob('Y2xhc2hy'): // clashr
      subscriptionContent = await generateClashConfig(finalLinks);
      contentType = 'text/yaml; charset=utf-8';
      break;
    case atob('c3VyZ2U='): // surge
    case atob('c3VyZ2Uy'):
    case atob('c3VyZ2Uz'):
    case atob('c3VyZ2U0'):
      subscriptionContent = generateSurgeConfig(finalLinks);
      break;
    case atob('cXVhbnR1bXVsdA=='): // quantumult
    case atob('cXVhbng='): // quanx
    case 'quanx':
      subscriptionContent = generateQuantumultConfig(finalLinks);
      break;
    default:
      // حالت پیش‌فرض (V2Ray / Base64)
      subscriptionContent = btoa(finalLinks.join('\n'));
  }

  return new Response(subscriptionContent, {
    headers: {
      'Content-Type': contentType,
      'Cache-Control': 'no-store, no-cache, must-revalidate, max-age=0',
      'Profile-Update-Interval': '12',
      'Subscription-Userinfo': 'upload=0; download=0; total=10737418240000000; expire=2546244464',
    },
  });
}

function generateLinksFromSource(list, user, workerDomain, globalIndexCounter) {
  const CF_HTTP_PORTS = [80, 8080, 8880, 2052, 2082, 2086, 2095];
  const CF_HTTPS_PORTS = [443, 2053, 2083, 2087, 2096, 8443];
  
  if (!globalIndexCounter) globalIndexCounter = { value: 1 };

  const defaultHttpsPorts = [443];
  const defaultHttpPorts = disableNonTLS ? [] : [80];
  const links = [];
  const wsPath = '/?ed=2560';
  const proto = 'vless';

  list.forEach(item => {
    const colo = item.colo ? item.colo.trim().toUpperCase() : '';
    const countryInfo = getCountryInfo(colo);
    const countryNameFancy = countryInfo.name;
    const flag = countryInfo.flag;
    
    let displayName = countryNameFancy;
    if (item.isp === 'Native Address') {
         if (!item.colo) displayName = toFancyArt('FireGate Server');
    }

    const safeIP = item.ip.includes(':') ? `[${item.ip}]` : item.ip;
    let portsToGenerate = [];

    if (item.port) {
      const port = item.port;
      if (CF_HTTPS_PORTS.includes(port)) portsToGenerate.push({ port: port, tls: true });
      else if (CF_HTTP_PORTS.includes(port) && !disableNonTLS) portsToGenerate.push({ port: port, tls: false });
      else portsToGenerate.push({ port: port, tls: true });
    } else {
      defaultHttpsPorts.forEach(port => portsToGenerate.push({ port: port, tls: true }));
      defaultHttpPorts.forEach(port => portsToGenerate.push({ port: port, tls: false }));
    }

    portsToGenerate.forEach(({ port, tls }) => {
      const rawNumber = String(globalIndexCounter.value).padStart(2, '0');
      const fancyNumber = toFancyArt(rawNumber);
      globalIndexCounter.value++;

      const finalRemark = `${flag} | ${displayName} ${fancyNumber}`;

      const params = new URLSearchParams();
      params.set('encryption', 'none');
      params.set('type', 'ws');
      params.set('host', workerDomain);
      params.set('path', wsPath);

      if (tls) {
        params.set('security', 'tls');
        params.set('sni', workerDomain);
        params.set('fp', 'random');
        params.set('allowInsecure', '1');
      } else {
        params.set('security', 'none');
      }

      const link = `${proto}://${user}@${safeIP}:${port}?${params.toString()}#${encodeURIComponent(finalRemark)}`;
      links.push(link);
    });
  });
  return links;
}

